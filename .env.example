# ==============================================================================
# 简历工坊 · 开源自托管配置示例 (.env)
# 默认无需配置任何 API Key 即可完整使用所有排版、模板、本地体检与「外部 AI 零配置协作」。
# 若你自托管部署并希望启用站内「一键直连 AI」，按需取消下方任意一组注释即可：
# ==============================================================================

# 服务端口（默认 3000）
PORT="3000"

# === 方案一：OpenAI 兼容接口（推荐，支持 DeepSeek / Kimi / 通义 / OpenAI / OneAPI / 本地 Ollama） ===
# 示例 1：DeepSeek
# AI_BASE_URL="https://api.deepseek.com/v1"
# AI_API_KEY="sk-your-deepseek-key"
# AI_MODEL="deepseek-chat"

# 示例 2：本地免费 Ollama（本地部署，无需 API Key）
# AI_BASE_URL="http://localhost:11434/v1"
# AI_MODEL="qwen2.5:14b"

# 示例 3：自建中转站（OneAPI / NewAPI）或任意兼容 OpenAI 的服务
# OPENAI_BASE_URL="https://your-relay.example.com/v1"
# OPENAI_API_KEY="sk-your-key"
# OPENAI_MODEL="gpt-4o-mini"

# === 方案二：Anthropic Claude 或兼容中转 ===
# ANTHROPIC_BASE_URL="https://api.anthropic.com"
# ANTHROPIC_API_KEY="sk-ant-your-key"
# ANTHROPIC_MODEL="claude-sonnet-4-20250514"
